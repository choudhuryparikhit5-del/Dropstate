{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Text",
      "default": "Drop 004 — Now Live"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "ENTER\nTHE STATE."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Oversized. Heavyweight. Vintage-washed. A new state of confidence, one drop at a time."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop the Drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}

<section class="hero" style="padding: 0;">
  <div class="hero-bg" style="background-image: url('{{ section.settings.hero_image | img_url: '1800x1400' }}');"></div>
  <div class="hero-content">
    <div class="wrap">
      <div class="hero-head">
        <span class="eyebrow">{{ section.settings.eyebrow_text }}</span>
        <h1 class="display">{{ section.settings.main_heading }}</h1>
      </div>
      <div class="hero-sub">
        <p>{{ section.settings.subheading }}</p>
        <a href="{{ section.settings.button_link }}" class="btn light">{{ section.settings.button_text }}</a>
      </div>
    </div>
  </div>
  <div class="scroll-cue">
    <div class="line"></div>
    <span>SCROLL</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 680px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--black);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 112%;
    top: -6%;
    background-size: cover;
    background-position: center 20%;
    opacity: 0.82;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.15) 0%, rgba(10, 10, 10, 0.05) 40%, rgba(10, 10, 10, 0.85) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: 76px;
  }

  .hero-content .wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }

  .hero-head {
    color: var(--white);
  }

  .hero-head .eyebrow {
    color: var(--orange);
    margin-bottom: 18px;
    display: block;
  }

  .hero-head h1 {
    font-size: clamp(64px, 9vw, 148px);
    color: var(--white);
  }

  .hero-sub {
    max-width: 280px;
  }

  .hero-sub p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
    margin-bottom: 22px;
    font-weight: 300;
  }

  .scroll-cue {
    position: absolute;
    bottom: 32px;
    right: 48px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.7);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.14em;
  }

  .scroll-cue .line {
    width: 1px;
    height: 36px;
    background: rgba(255, 255, 255, 0.4);
    position: relative;
    overflow: hidden;
  }

  .scroll-cue .line::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 40%;
    background: var(--orange);
    animation: scrolldown 2s ease-in-out infinite;
  }

  @keyframes scrolldown {
    0% { top: -40%; }
    100% { top: 100%; }
  }

  @media (max-width: 980px) {
    .hero-content .wrap {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    
    .scroll-cue {
      bottom: 24px;
      right: 24px;
    }
  }
</style>