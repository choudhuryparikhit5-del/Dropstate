<div class="product-card">
  <div class="product-card-image">
    {% if product.featured_image %}
      <a href="{{ product.url }}" class="product-image-link">
        <img 
          src="{{ product.featured_image | img_url: '400x400' }}" 
          alt="{{ product.featured_image.alt }}"
          class="product-image"
          loading="lazy"
        >
      </a>
      
      {% if product.images.size > 1 %}
        <img 
          src="{{ product.images[1] | img_url: '400x400' }}" 
          alt="{{ product.images[1].alt }}"
          class="product-image-hover"
          loading="lazy"
        >
      {% endif %}

      {% if product.compare_at_price and product.available %}
        <div class="product-badge">
          {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
          {{ discount }}% OFF
        </div>
      {% endif %}

      {% unless product.available %}
        <div class="product-badge sold-out">Sold Out</div>
      {% endunless %}
    {% endif %}
  </div>

  <div class="product-card-content">
    <div class="product-card-header">
      <a href="{{ product.url }}" class="product-card-title">{{ product.title }}</a>
      <button class="wishlist-btn" onclick="toggleWishlist(this, '{{ product.id }}')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>
    </div>

    <div class="product-card-rating">
      <span class="rating-stars">★★★★★</span>
      <span class="rating-count">(0)</span>
    </div>

    <div class="product-card-price">
      {% if product.available %}
        <span class="price">{{ product.price | money_with_currency }}</span>
        {% if product.compare_at_price %}
          <span class="original-price">{{ product.compare_at_price | money_with_currency }}</span>
        {% endif %}
      {% else %}
        <span class="price out-of-stock">Sold Out</span>
      {% endif %}
    </div>

    {% if product.options.size > 0 and product.options[0].name != 'Title' %}
      <div class="product-card-options">
        <div class="option-values">
          {% for value in product.options[0].values | slice: 0, 5 %}
            <span class="option-value" title="{{ value }}">{{ value | slice: 0, 2 }}</span>
          {% endfor %}
          {% if product.options[0].values.size > 5 %}
            <span class="option-value more">+{{ product.options[0].values.size | minus: 5 }}</span>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <form action="/cart/add" method="post" class="product-card-form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button 
        type="submit" 
        class="btn btn-small btn-add-to-cart"
        {% unless product.available %}disabled{% endunless %}
      >
        {% if product.available %}
          Add to Bag
        {% else %}
          Sold Out
        {% endif %}
      </button>
    </form>
  </div>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 2px;
    overflow: hidden;
    transition: all 0.3s var(--ease);
  }

  .product-card:hover {
    border-color: var(--orange);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .product-card-image {
    position: relative;
    background: var(--off-white);
    aspect-ratio: 1;
    overflow: hidden;
  }

  .product-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-image,
  .product-image-hover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s var(--ease);
  }

  .product-image-hover {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .product-card:hover .product-image {
    opacity: 0;
  }

  .product-card:hover .product-image-hover {
    opacity: 1;
  }

  .product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--orange);
    color: var(--white);
    padding: 6px 12px;
    border-radius: 2px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .product-badge.sold-out {
    background: var(--gray);
  }

  .product-card-content {
    flex: 1;
    padding: 16px;
    display: flex;
    flex-direction: column;
  }

  .product-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
  }

  .product-card-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--black);
    flex: 1;
    transition: color 0.3s var(--ease);
  }

  .product-card-title:hover {
    color: var(--orange);
  }

  .wishlist-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: var(--gray);
    transition: all 0.3s var(--ease);
    flex-shrink: 0;
  }

  .wishlist-btn:hover,
  .wishlist-btn.active {
    color: var(--orange);
  }

  .product-card-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .rating-stars {
    color: var(--orange);
    font-size: 13px;
  }

  .rating-count {
    color: var(--gray);
  }

  .product-card-price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .price {
    font-size: 16px;
    font-weight: 600;
  }

  .original-price {
    font-size: 13px;
    color: var(--gray);
    text-decoration: line-through;
  }

  .price.out-of-stock {
    color: var(--gray);
    font-size: 14px;
  }

  .product-card-options {
    margin-bottom: 12px;
  }

  .option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .option-value {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--off-white);
    border: 1px solid var(--line);
    border-radius: 2px;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s var(--ease);
  }

  .option-value:hover {
    border-color: var(--orange);
  }

  .option-value.more {
    cursor: default;
    font-size: 10px;
  }

  .product-card-form {
    margin-top: auto;
  }

  .btn-small {
    padding: 10px 16px;
    font-size: 11px;
  }

  .btn-add-to-cart {
    width: 100%;
  }

  @media (max-width: 980px) {
    .product-card-content {
      padding: 12px;
    }

    .product-card-title {
      font-size: 13px;
    }
  }

  @media (max-width: 600px) {
    .product-card {
      border: none;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .product-card-content {
      padding: 12px;
    }

    .product-card-title {
      font-size: 12px;
    }

    .wishlist-btn {
      display: none;
    }
  }
</style>

<script>
  function toggleWishlist(btn, productId) {
    btn.classList.toggle('active');
    
    // Get current wishlist from localStorage
    let wishlist = JSON.parse(localStorage.getItem('dropstate_wishlist') || '[]');
    
    if (btn.classList.contains('active')) {
      if (!wishlist.includes(productId)) {
        wishlist.push(productId);
      }
    } else {
      wishlist = wishlist.filter(id => id !== productId);
    }
    
    localStorage.setItem('dropstate_wishlist', JSON.stringify(wishlist));
  }

  // Check if product is in wishlist on load
  document.addEventListener('DOMContentLoaded', function() {
    const wishlistBtns = document.querySelectorAll('.wishlist-btn');
    const wishlist = JSON.parse(localStorage.getItem('dropstate_wishlist') || '[]');
    
    wishlistBtns.forEach(btn => {
      const card = btn.closest('.product-card');
      if (card) {
        const link = card.querySelector('.product-card-title');
        const productUrl = link ? link.getAttribute('href') : '';
        const productId = productUrl ? productUrl.split('/products/')[1] : '';
        
        if (wishlist.includes(productId)) {
          btn.classList.add('active');
        }
      }
    });
  });

  // Handle form submission
  document.querySelectorAll('.product-card-form').forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      dropstate.addToCart(this);
    });
  });
</script>