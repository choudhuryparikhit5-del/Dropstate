<header id="siteHeader">
  <div class="wrap">
    <button class="burger" id="burgerBtn" aria-label="Open menu">
      <svg width="22" height="16" viewBox="0 0 22 16" fill="none"><path d="M0 1H22M0 8H22M0 15H22" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
    
    <a href="/" class="logo">
      {% if shop.logo %}
        <img src="{{ shop.logo | img_url: '140x50' }}" alt="{{ shop.name }}" height="40" width="auto">
      {% else %}
        <span>{{ shop.name }}</span>
      {% endif %}
    </a>

    <nav class="main-nav">
      <a href="/collections/all">Shop</a>
      <a href="/pages/about">About</a>
      <a href="/pages/size-guide">Size Guide</a>
      <a href="/pages/contact">Contact</a>
    </nav>

    <div class="header-icons">
      <button aria-label="Search" class="search-btn">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3"/><path d="M13 13L17 17" stroke="currentColor" stroke-width="1.3"/></svg>
      </button>
      
      <button aria-label="Account" class="account-btn">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="5.5" r="3.2" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 16C3.5 12.5 6 11 9 11C12 11 14.5 12.5 15.5 16" stroke="currentColor" stroke-width="1.3"/></svg>
      </button>
      
      <button aria-label="Wishlist" class="wishlist-btn">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 15.5C9 15.5 1.5 11.2 1.5 6.2C1.5 3.6 3.5 1.8 6 1.8C7.3 1.8 8.5 2.4 9 3.5C9.5 2.4 10.7 1.8 12 1.8C14.5 1.8 16.5 3.6 16.5 6.2C16.5 11.2 9 15.5 9 15.5Z" stroke="currentColor" stroke-width="1.3"/></svg>
      </button>
      
      <button aria-label="Cart" id="cartOpenBtn" class="cart-btn">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M1.5 4.5H16.5L15.3 14.2C15.2 15 14.5 15.6 13.7 15.6H4.3C3.5 15.6 2.8 15 2.7 14.2L1.5 4.5Z" stroke="currentColor" stroke-width="1.3"/><path d="M5.5 4.5V4C5.5 2.3 6.9 1 8.6 1H9.4C11.1 1 12.5 2.3 12.5 4V4.5" stroke="currentColor" stroke-width="1.3"/></svg>
        <span class="cart-count">{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 29px;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 26px 0;
    transition: all 0.5s var(--ease);
  }

  header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
  }

  header.scrolled {
    top: 0;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .logo img {
    height: 36px;
    width: auto;
    filter: brightness(0) invert(1);
    transition: filter 0.5s var(--ease);
  }

  header.scrolled .logo img {
    filter: none;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  nav.main-nav {
    display: flex;
    gap: 40px;
  }

  nav.main-nav a {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--white);
    font-weight: 500;
    position: relative;
    padding-bottom: 4px;
    font-family: 'JetBrains Mono', monospace;
  }

  header.scrolled nav.main-nav a {
    color: var(--black);
  }

  nav.main-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--orange);
    transition: width 0.4s var(--ease);
  }

  nav.main-nav a:hover::after {
    width: 100%;
  }

  .header-icons {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .header-icons button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--white);
    transition: color 0.5s var(--ease);
    position: relative;
    padding: 0;
    display: flex;
    align-items: center;
  }

  header.scrolled .header-icons button {
    color: var(--black);
  }

  .header-icons button:hover {
    color: var(--orange);
  }

  .cart-count {
    position: absolute;
    top: -7px;
    right: -9px;
    background: var(--orange);
    color: var(--white);
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .burger {
    display: none;
  }

  .wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 48px;
  }

  @media (max-width: 980px) {
    .wrap {
      padding: 0 24px;
    }

    nav.main-nav {
      display: none;
    }

    .logo img {
      height: 28px;
    }

    .burger {
      display: block;
      background: none;
      border: none;
      color: var(--white);
      cursor: pointer;
    }

    header.scrolled .burger {
      color: var(--black);
    }

    header .wrap {
      padding: 0 24px;
    }
  }
</style>

<script>
  const header = document.getElementById('siteHeader');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });
</script>